{
  "name": "react-world-map-extended",
  "version": "0.0.0",
  "description": "React World Map Extended is a React component that provides an interactive world map with extended features. It allows users to visualize data on a world map, customize the appearance, and interact with countries.",
  "author": "Amitt K Sharma",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./country-data.schema.json": "./schema/country-data.schema.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amittkSharma/react-world-map-extended.git"
  },
  "keywords": [
    "react",
    "world-map",
    "map",
    "svg",
    "countries",
    "country-info",
    "choropleth",
    "interactive-map",
    "typescript"
  ],
  "bugs": {
    "url": "https://github.com/amittkSharma/react-world-map-extended/issues"
  },
  "homepage": "https://github.com/amittkSharma/react-world-map-extended#readme",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@rsbuild/core": "2.1.4",
    "@rsbuild/plugin-react": "2.1.0",
    "@rslib/core": "1.0.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "ajv": "8.20.0",
    "commit-and-tag-version": "12.7.3",
    "jsdom": "29.1.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rslib build",
    "build-example": "rsbuild build",
    "lint": "biome lint --error-on-warnings .",
    "lint:fix": "biome check --write",
    "build-package": "npm run lint && npm run typecheck && npm test && npm run build",
    "release": "commit-and-tag-version",
    "typecheck": "tsc --noEmit && tsc -p tests --noEmit && tsc -p example --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "i18n-iso-countries-extended-info": "1.8.0",
    "react-svg-worldmap": "2.0.2"
  }
}
